<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="six_dof_arm">

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.4 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.4 0.1"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia
        ixx="0.01417"
        ixy="0.0"
        ixz="0.0"
        iyy="0.01417"
        iyz="0.0"
        izz="0.02667"/>
    </inertial>

  </link>

     <link name="link_1">

    <visual>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.18 0.5"/>
      </geometry>
      <material name="green">
        <color rgba="0.1 0.7 0.2 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.18 0.5"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia
        ixx="0.02303"
        ixy="0.0"
        ixz="0.0"
        iyy="0.02203"
        iyz="0.0"
        izz="0.00540"/>
    </inertial>

  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit
      lower="-3.14159"
      upper="3.14159"
      effort="100.0"
      velocity="1.0"/>
  </joint>


   <link name="link_2">

    <visual>
      <origin xyz="0.325 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.65 0.16 0.14"/>
      </geometry>
      <material name="orange">
        <color rgba="0.9 0.4 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0.325 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.65 0.16 0.14"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.325 0 0" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia
        ixx="0.00452"
        ixy="0.0"
        ixz="0.0"
        iyy="0.04421"
        iyz="0.0"
        izz="0.04481"/>
    </inertial>

  </link>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit
      lower="-1.5708"
      upper="1.5708"
      effort="80.0"
      velocity="1.0"/>
  </joint>

  <link name="link_3">

    <visual>
      <origin xyz="0.275 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.55 0.14 0.14"/>
      </geometry>
      <material name="yellow">
        <color rgba="0.9 0.75 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0.275 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.55 0.14 0.14"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.275 0 0" rpy="0 0 0"/>
      <mass value="0.9"/>
      <inertia
        ixx="0.00294"
        ixy="0.0"
        ixz="0.0"
        iyy="0.02416"
        iyz="0.0"
        izz="0.02416"/>
    </inertial>

  </link>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0.65 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit
      lower="-2.0"
      upper="2.0"
      effort="60.0"
      velocity="1.2"/>
  </joint>

   <link name="link_4">

    <visual>
      <origin xyz="0.2 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.12 0.12"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.1 0.1 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0.2 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.12 0.12"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.2 0 0" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia
        ixx="0.00144"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00872"
        iyz="0.0"
        izz="0.00872"/>
    </inertial>

  </link>

  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0.55 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit
      lower="-3.14159"
      upper="3.14159"
      effort="40.0"
      velocity="1.5"/>
  </joint>

  <link name="link_5">

    <visual>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.11 0.11"/>
      </geometry>
      <material name="purple">
        <color rgba="0.5 0.1 0.7 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.11 0.11"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia
        ixx="0.00081"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00340"
        iyz="0.0"
        izz="0.00340"/>
    </inertial>

  </link>

  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0.4 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit
      lower="-1.5708"
      upper="1.5708"
      effort="30.0"
      velocity="1.5"/>
  </joint>

  <link name="link_6">

    <visual>
      <origin xyz="0.125 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.1 0.1"/>
      </geometry>
      <material name="gray">
        <color rgba="0.35 0.35 0.35 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0.125 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.1 0.1"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.125 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia
        ixx="0.00050"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00181"
        iyz="0.0"
        izz="0.00181"/>
    </inertial>

  </link>

  <joint name="joint_6" type="revolute">
    <parent link="link_5"/>
    <child link="link_6"/>
    <origin xyz="0.3 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit
      lower="-3.14159"
      upper="3.14159"
      effort="20.0"
      velocity="2.0"/>
  </joint>

  <link name="tool0">

    <visual>
      <origin xyz="0.06 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.12 0.12"/>
      </geometry>
      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0.06 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.12 0.12"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.06 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia
        ixx="0.00048"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00048"
        iyz="0.0"
        izz="0.00048"/>
    </inertial>

  </link>

  <joint name="tool0_fixed_joint" type="fixed">
    <parent link="link_6"/>
    <child link="tool0"/>
    <origin xyz="0.25 0 0" rpy="0 0 0"/>
  </joint>

   <link name="gripper_base">

    <visual>
      <origin xyz="0.08 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.20 0.14"/>
      </geometry>
      <material name="gripper_blue">
        <color rgba="0.05 0.25 0.55 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0.08 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.20 0.14"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.08 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia
        ixx="0.00124"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00094"
        iyz="0.0"
        izz="0.00137"/>
    </inertial>

  </link>

  <joint name="gripper_mount_joint" type="fixed">
    <parent link="tool0"/>
    <child link="gripper_base"/>
    <origin xyz="0.12 0 0" rpy="0 0 0"/>
  </joint>

  <link name="gripper_left_finger">

    <visual>
      <origin xyz="0.10 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.04 0.06"/>
      </geometry>
      <material name="finger_gray">
        <color rgba="0.55 0.55 0.55 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0.10 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.04 0.06"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.10 0 0" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia
        ixx="0.000043"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000363"
        iyz="0.0"
        izz="0.000347"/>
    </inertial>

  </link>

  <joint name="gripper_left_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="gripper_left_finger"/>
    <origin xyz="0 0.09 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit
      lower="0.0"
      upper="0.06"
      effort="20.0"
      velocity="0.2"/>
  </joint>

  <link name="gripper_right_finger">

    <visual>
      <origin xyz="0.10 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.04 0.06"/>
      </geometry>
      <material name="finger_gray">
        <color rgba="0.55 0.55 0.55 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0.10 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.04 0.06"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.10 0 0" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia
        ixx="0.000043"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000363"
        iyz="0.0"
        izz="0.000347"/>
    </inertial>

  </link>

  <joint name="gripper_right_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="gripper_right_finger"/>
    <origin xyz="0 -0.09 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit
      lower="0.0"
      upper="0.06"
      effort="20.0"
      velocity="0.2"/>
  </joint>



  <!-- gazebo_initial_static_settings -->
  <!-- İlk Gazebo yükleme testi için robot sabit tutulur. -->
  <gazebo>
    <static>false</static>
    <self_collide>false</self_collide>
  </gazebo>

  <!-- ros2_control_initial_configuration -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="joint_1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_6">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find six_dof_arm_description)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- dynamic_world_anchor_configuration -->
  <!-- Robot tabanını Gazebo dünyasına sabitler. -->
  <link name="world"/>

  <joint name="world_fixed_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
